# SMTP sender configuration for the implementation-request form.
# Use a Gmail App Password or credentials from another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Siksha Tantra Website <your-sender@gmail.com>"
LEAD_NOTIFICATION_EMAIL=aditya26.upadhyay@gmail.com

# Public origin of the deployed site (no trailing slash). Used for canonical
# URLs, Open Graph metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.shikshatantra.shop

# Optional ownership verification tokens from Google Search Console and Bing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: secondary persistence for form submissions. Email delivery remains
# the primary success condition; lead records are stored in the leadrequests collection.
MONGODB_URI=
