# --- Email (required: the demo form only reports success once the lead email is sent) ---
# Any SMTP provider works (Google Workspace / Gmail App Password, Zoho, SendGrid, Mailgun, ...).
# smtp.ethereal.email is a TEST-ONLY service that never delivers mail; never use it in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shiksha Tantra Website <your-sender@example.com>"
# Inbox that receives every demo request. Defaults to aditya26.upadhyay@gmail.com when unset.
LEAD_NOTIFICATION_EMAIL=aditya26.upadhyay@gmail.com

# --- Public contact channels (shown on the site; these override the built-in defaults) ---
# Contact email shown on the site and in acknowledgement emails (default listen@shikshatantra.shop; must be a working mailbox).
NEXT_PUBLIC_CONTACT_EMAIL=listen@shikshatantra.shop
# WhatsApp number, digits only. A 10-digit Indian mobile gets the 91 country code automatically.
NEXT_PUBLIC_WHATSAPP_NUMBER=9407174355
# Optional external scheduler (Calendly etc.). Leave empty: the site's own /request-demo form is the booking form.
NEXT_PUBLIC_BOOKING_URL=

# --- Optional spam protection: Cloudflare Turnstile (set both, or neither) ---
# Site key renders the widget in the form; secret key makes /api/lead verify the token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public origin of the deployed site (no trailing slash). Used for canonical
# URLs, Open Graph metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.shikshatantra.shop

# Optional ownership verification tokens from Google Search Console and Bing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: secondary persistence for form submissions. Email delivery remains
# the primary success condition; lead records are stored in the leadrequests collection.
MONGODB_URI=
